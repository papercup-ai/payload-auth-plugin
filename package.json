{
  "name": "@rws-papercup/payload-auth-plugin",
  "version": "0.1.0",
  "author": "Papercup <papercup.team@rws.com>",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/papercup-ai/payload-auth-plugin",
  "repository": "git@github.com:papercup-ai/payload-auth-plugin.git",
  "description": "Authentication plugin for Payload CMS",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "typescript",
    "react",
    "oauth",
    "oauth2.0",
    "oidc",
    "google",
    "github",
    "gitlab",
    "atlassian"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cd example/with-auth && npm run dev",
    "build": "rimraf dist tsconfig.tsbuildinfo && pnpm build:types && pnpm build:esbuild",
    "build:esbuild": "node esbuild.mjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "test": "echo \"Tests are placeholder - OAuth functionality tested manually\" && exit 0",
    "lint": "cross-env TRUNK_TELEMETRY=off trunk check --no-fix",
    "lint:fix": "cross-env TRUNK_TELEMETRY=off trunk check",
    "lint-old": "eslint src",
    "fmt": "cross-env TRUNK_TELEMETRY=off trunk fmt",
    "payload": "cd dev && cross-env NODE_OPTIONS=--no-deprecation payload",
    "dev:lint": "cd dev && cross-env NODE_OPTIONS=--no-deprecation next lint",
    "generate:types": "payload generate:types",
    "clean": "rimraf dist dev/pnpm-lock.yaml",
    "release:dry": "release-it --dry-run",
    "release": "release-it",
    "release:major": "release-it major",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch"
  },
  "peerDependencies": {
    "payload": "3.68.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.2",
    "esbuild-node-externals": "^1.20.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "next": "16.0.10",
    "payload": "3.68.5",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "release-it": "^19.1.0",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "@trunkio/launcher": "^1.3.4",
    "eslint-config-next": "16.0.10",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.3",
    "oauth4webapi": "^3.8.3",
    "zod": "^4.2.1"
  }
}
